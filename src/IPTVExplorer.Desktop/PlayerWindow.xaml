<Window x:Class="IPTVExplorer.Desktop.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IPTVExplorer.Desktop"
        Title="Lecteur — IPTV Explorer" Width="1200" Height="760" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="#05070A" Foreground="#F8FAFC"
        FontFamily="Segoe UI" KeyDown="OnKeyDown" Closing="OnClosing">
  <Window.Resources>
    <Style x:Key="ControlButton" TargetType="Button">
      <Setter Property="Foreground" Value="#F8FAFC" />
      <Setter Property="Background" Value="#1B2430" />
      <Setter Property="BorderBrush" Value="#334155" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#263445" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#4B6482" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#111827" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ControlButton}">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="BorderBrush" Value="#3B82F6" />
    </Style>

    <Style x:Key="TrackCombo" TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F8FAFC" />
      <Setter Property="Background" Value="#111827" />
      <Setter Property="BorderBrush" Value="#334155" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Height" Value="38" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#94A3B8" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
  </Window.Resources>

  <Grid Background="#05070A">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="Black">
      <local:NativeVideoHost x:Name="VideoHost" />
    </Border>

    <Border Grid.Row="1" Margin="12,10,12,12" Padding="18,16,18,16" CornerRadius="14"
            Background="#101722" BorderBrush="#253248" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="80" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="PositionLabel" Grid.Column="0" VerticalAlignment="Center" Foreground="#CBD5E1"
                     FontFamily="Consolas" FontSize="13" Text="00:00" />
          <Slider x:Name="PositionSlider" Grid.Column="1" Minimum="0" Maximum="1" Margin="8,0,12,0"
                  Foreground="#3B82F6" Background="#263445"
                  PreviewMouseLeftButtonDown="OnSeekStarted" PreviewMouseLeftButtonUp="OnSeekCompleted" />
          <TextBlock x:Name="DurationLabel" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                     Foreground="#94A3B8" FontFamily="Consolas" FontSize="13" Text="/ 00:00" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,13,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Button x:Name="PlayPauseButton" Grid.Column="0" Width="92" Margin="0,0,8,0"
                  Style="{StaticResource PrimaryButton}" Click="OnPlayPause" ToolTip="Lecture / pause (Espace)">Pause</Button>
          <Button Grid.Column="1" Width="76" Margin="0,0,14,0" Style="{StaticResource ControlButton}"
                  Click="OnStop" ToolTip="Arrêter la lecture">Stop</Button>

          <TextBlock Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#94A3B8" Text="Volume" />
          <Slider x:Name="VolumeSlider" Grid.Column="3" Minimum="0" Maximum="100" Value="80" Margin="0,0,12,0"
                  VerticalAlignment="Center" Foreground="#3B82F6" Background="#263445" ValueChanged="OnVolumeChanged" />

          <Border Grid.Column="5" Margin="0,0,10,0" Padding="11,7" CornerRadius="999"
                  Background="#172033" BorderBrush="#2C3A52" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,7,0" />
              <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#CBD5E1" FontSize="12" Text="Prêt" />
            </StackPanel>
          </Border>

          <Button Grid.Column="6" MinWidth="112" Style="{StaticResource ControlButton}" Click="OnFullscreen"
                  ToolTip="Basculer le plein écran (F11)">Plein écran</Button>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource SectionLabel}" Text="PISTE AUDIO" Margin="2,0,0,6" />
            <ComboBox x:Name="AudioTracks" Style="{StaticResource TrackCombo}" SelectionChanged="OnAudioTrackChanged" />
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Style="{StaticResource SectionLabel}" Text="SOUS-TITRES" Margin="2,0,0,6" />
            <ComboBox x:Name="SubtitleTracks" Style="{StaticResource TrackCombo}" SelectionChanged="OnSubtitleTrackChanged" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
