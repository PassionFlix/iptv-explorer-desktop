<Window x:Class="IPTVExplorer.Desktop.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IPTVExplorer.Desktop"
        Title="Lecteur — IPTV Explorer" Width="1100" Height="700" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#090d15" Foreground="#f5f7fb"
        KeyDown="OnKeyDown" Closing="OnClosing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="Black">
      <local:NativeVideoHost x:Name="VideoHost" />
    </Border>

    <Border Grid.Row="1" Background="#151d2a" Padding="14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button x:Name="PlayPauseButton" Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" Padding="14,7" Click="OnPlayPause">Pause</Button>
        <Button Grid.Row="0" Grid.Column="1" Margin="0,0,12,0" Padding="14,7" Click="OnStop">Stop</Button>
        <Slider x:Name="PositionSlider" Grid.Row="0" Grid.Column="2" Minimum="0" Maximum="1"
                PreviewMouseLeftButtonDown="OnSeekStarted" PreviewMouseLeftButtonUp="OnSeekCompleted" />
        <TextBlock x:Name="PositionLabel" Grid.Row="0" Grid.Column="3" Margin="12,0,5,0" VerticalAlignment="Center" Text="00:00" />
        <TextBlock x:Name="DurationLabel" Grid.Row="0" Grid.Column="3" Margin="55,0,12,0" VerticalAlignment="Center" Text="/ 00:00" />
        <Slider x:Name="VolumeSlider" Grid.Row="0" Grid.Column="4" Minimum="0" Maximum="100" Value="80" Margin="8,0" ValueChanged="OnVolumeChanged" />
        <Button Grid.Row="0" Grid.Column="5" Padding="12,7" Click="OnFullscreen">Plein écran</Button>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,12,0,0">
          <TextBlock VerticalAlignment="Center" Margin="0,0,7,0" Text="Audio" />
          <ComboBox x:Name="AudioTracks" Width="240" Margin="0,0,16,0" SelectionChanged="OnAudioTrackChanged" />
          <TextBlock VerticalAlignment="Center" Margin="0,0,7,0" Text="Sous-titres" />
          <ComboBox x:Name="SubtitleTracks" Width="260" SelectionChanged="OnSubtitleTrackChanged" />
          <TextBlock x:Name="StatusText" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="#aab6c8" Text="Prêt" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
