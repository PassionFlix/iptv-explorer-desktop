<Window x:Class="IPTVExplorer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="IPTV Explorer Desktop" Width="1280" Height="800" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#09101d">
  <Grid>
    <TextBlock x:Name="FallbackMessage" Visibility="Collapsed" Foreground="White" FontSize="18"
               TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560" />
    <wv2:WebView2 x:Name="Browser" />
  </Grid>
</Window>
