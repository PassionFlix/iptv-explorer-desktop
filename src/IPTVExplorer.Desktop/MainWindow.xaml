<Window x:Class="IPTVExplorer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IPTVExplorer.Desktop"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="IPTV Explorer"
        Width="1500" Height="820" MinWidth="1120" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#070D18"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="OnMainWindowPreviewKeyDown">
  <Grid x:Name="RootLayout" Background="#070D18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="BrowserColumn" Width="*" />
      <ColumnDefinition x:Name="LivePlayerColumn" Width="0" />
    </Grid.ColumnDefinitions>

    <Grid x:Name="BrowserHost" Grid.Column="0" Background="#070D18">
      <TextBlock x:Name="FallbackMessage" Visibility="Collapsed" Foreground="White" FontSize="18"
                 TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextWrapping="Wrap" MaxWidth="560" />
      <wv2:WebView2 x:Name="Browser" />
    </Grid>

    <!-- WebView2 and libmpv are HWND-backed. Separate, non-overlapping grid columns avoid airspace/z-order conflicts. -->
    <Border x:Name="LivePlayerPane" Grid.Column="1" Visibility="Collapsed"
            Background="#070B12" BorderBrush="#263248" BorderThickness="1,0,0,0">
      <Grid x:Name="LivePlayerLayout" Margin="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="LiveHeaderPanel" Grid.Row="0" Margin="2,0,2,10">
          <TextBlock Foreground="#7F8DA6" FontSize="10" FontWeight="SemiBold" Text="LECTEUR LIVE NATIF" />
          <TextBlock x:Name="LivePlayerTitle" Margin="0,4,0,0" Foreground="#F8FAFC"
                     FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                     Text="Sélectionnez une chaîne" />
        </StackPanel>

        <Border x:Name="LiveVideoFrame" Grid.Row="1" MinHeight="240" Background="Black" BorderBrush="#1F2937"
                BorderThickness="1" CornerRadius="8" ClipToBounds="True">
          <Grid>
            <Grid x:Name="LiveIdlePlaceholder" IsHitTestVisible="False">
              <Grid.Background>
                <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.72" RadiusY="0.88">
                  <GradientStop Color="#182743" Offset="0" />
                  <GradientStop Color="#0A1220" Offset="0.52" />
                  <GradientStop Color="#050A12" Offset="1" />
                </RadialGradientBrush>
              </Grid.Background>
              <Ellipse Width="430" Height="430" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#172A46" StrokeThickness="1" Opacity="0.58" />
              <Ellipse Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#1D3556" StrokeThickness="1" Opacity="0.72" />
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                <Border Width="92" Height="92" HorizontalAlignment="Center" CornerRadius="24" Background="#0E1728" BorderBrush="#4F6BFF" BorderThickness="2">
                  <Grid>
                    <Border Width="64" Height="64" CornerRadius="18" Background="#111E33" BorderBrush="#27D3C2" BorderThickness="1" />
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F8FAFC" FontSize="27" FontWeight="Bold" Text="IE" />
                  </Grid>
                </Border>
                <TextBlock x:Name="LivePlaceholderTitle" Margin="0,22,0,0" HorizontalAlignment="Center" Foreground="#F8FAFC" FontSize="24" FontWeight="SemiBold" Text="Sélectionnez une chaîne" />
                <TextBlock x:Name="LivePlaceholderSubtitle" Margin="0,9,0,0" HorizontalAlignment="Center" Foreground="#8FA2BC" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Text="Choisissez une chaîne dans la liste pour démarrer la lecture." />
              </StackPanel>
            </Grid>
            <local:NativeVideoHost x:Name="LiveVideoHost" Visibility="Collapsed" />
            <Border x:Name="LiveStatusBadge" Margin="10" Padding="9,5" VerticalAlignment="Top" HorizontalAlignment="Left"
                    CornerRadius="999" Background="#C0141B26" IsHitTestVisible="False" Visibility="Collapsed">
              <TextBlock x:Name="LiveStatusText" Foreground="#D7E0EC" FontSize="11" Text="Prêt" />
            </Border>
          </Grid>
        </Border>

        <Border x:Name="LiveFullscreenControlsAnchor" Grid.Row="1" Height="0" VerticalAlignment="Bottom" />
        <Popup x:Name="LiveFullscreenControlsPopup" PlacementTarget="{Binding ElementName=LiveFullscreenControlsAnchor}"
               Placement="Top" StaysOpen="True" AllowsTransparency="True">
          <Border x:Name="LiveFullscreenControlsPanel" Margin="18" Padding="12" CornerRadius="12"
                  Background="#E8101722" BorderBrush="#334155" BorderThickness="1"
                  PreviewMouseMove="OnLiveFullscreenControlsPointerMoved"
                  PreviewMouseDown="OnLiveFullscreenControlsInteracted"
                  PreviewMouseUp="OnLiveFullscreenControlsInteracted">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button x:Name="LiveFullscreenPlayPauseButton" Grid.Column="0" MinWidth="92" Height="36"
                      Margin="0,0,8,0" Background="#2563EB" Foreground="White" BorderBrush="#3B82F6"
                      BorderThickness="1" Cursor="Hand" Click="OnLivePlayPause">Pause</Button>
              <Button Grid.Column="1" MinWidth="72" Height="36" Background="#182130" Foreground="#E2E8F0"
                      BorderBrush="#334155" BorderThickness="1" Cursor="Hand" Click="OnLiveStop">Stop</Button>
              <TextBlock Grid.Column="2" Margin="14,0" VerticalAlignment="Center" Foreground="#CBD5E1"
                         Text="F11 / Échap pour quitter" />
              <Button Grid.Column="3" MinWidth="110" Height="36" Background="#182130" Foreground="#E2E8F0"
                      BorderBrush="#334155" BorderThickness="1" Cursor="Hand" Click="OnLiveFullscreen">Quitter</Button>
            </Grid>
          </Border>
        </Popup>

        <Grid x:Name="LiveControlsPanel" Grid.Row="2" Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button x:Name="LivePlayPauseButton" Grid.Column="0" MinWidth="82" Height="34"
                  Margin="0,0,8,0" Background="#2563EB" Foreground="White" BorderBrush="#3B82F6"
                  BorderThickness="1" Cursor="Hand" Click="OnLivePlayPause">Pause</Button>
          <Button Grid.Column="1" MinWidth="64" Height="34" Margin="0,0,12,0"
                  Background="#182130" Foreground="#E2E8F0" BorderBrush="#334155"
                  BorderThickness="1" Cursor="Hand" Click="OnLiveStop">Stop</Button>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#94A3B8" Text="Volume" />
            <Slider x:Name="LiveVolumeSlider" Width="104" Minimum="0" Maximum="100" Value="80"
                    VerticalAlignment="Center" ValueChanged="OnLiveVolumeChanged" />
          </StackPanel>
          <Button x:Name="LiveFullscreenButton" Grid.Column="3" MinWidth="104" Height="34"
                  Background="#182130" Foreground="#E2E8F0" BorderBrush="#334155"
                  BorderThickness="1" Cursor="Hand" Click="OnLiveFullscreen">Plein écran</Button>
        </Grid>

        <Grid x:Name="LiveTracksPanel" Grid.Row="3" Margin="0,10,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Margin="2,0,0,5" Foreground="#7F8DA6"
                     FontSize="10" FontWeight="SemiBold" Text="AUDIO" />
          <TextBlock Grid.Row="0" Grid.Column="2" Margin="2,0,0,5" Foreground="#7F8DA6"
                     FontSize="10" FontWeight="SemiBold" Text="SOUS-TITRES" />
          <ComboBox x:Name="LiveAudioTracks" Grid.Row="1" Grid.Column="0" Height="34"
                    Background="#101722" Foreground="#E2E8F0" BorderBrush="#334155"
                    SelectionChanged="OnLiveAudioTrackChanged" />
          <ComboBox x:Name="LiveSubtitleTracks" Grid.Row="1" Grid.Column="2" Height="34"
                    Background="#101722" Foreground="#E2E8F0" BorderBrush="#334155"
                    SelectionChanged="OnLiveSubtitleTrackChanged" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
