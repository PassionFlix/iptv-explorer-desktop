<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\IPTVExplorer.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\IPTVExplorer.Core\IPTVExplorer.Core.csproj" />
    <ProjectReference Include="..\IPTVExplorer.Infrastructure\IPTVExplorer.Infrastructure.csproj" />
    <ProjectReference Include="..\IPTVExplorer.Providers\IPTVExplorer.Providers.csproj" />
    <ProjectReference Include="..\IPTVExplorer.Player\IPTVExplorer.Player.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\IPTVExplorer.ico" />
    <Content Include="ui\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="native\mpv\libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('native\mpv\libmpv-2.dll')" />
    <Content Include="native\mpv\README.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('native\mpv\README.txt')" />
  </ItemGroup>
</Project>
