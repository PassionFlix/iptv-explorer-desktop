<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>$(BaseIntermediateOutputPath)IPTVExplorer.generated.ico</ApplicationIcon>
    <LibMpvRuntimeDirectory>$(MSBuildProjectDirectory)\native\mpv</LibMpvRuntimeDirectory>
    <LibMpvLibraryPath>$(LibMpvRuntimeDirectory)\libmpv-2.dll</LibMpvLibraryPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\IPTVExplorer.Core\IPTVExplorer.Core.csproj" />
    <ProjectReference Include="..\IPTVExplorer.Infrastructure\IPTVExplorer.Infrastructure.csproj" />
    <ProjectReference Include="..\IPTVExplorer.Providers\IPTVExplorer.Providers.csproj" />
    <ProjectReference Include="..\IPTVExplorer.Player\IPTVExplorer.Player.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="ui\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="native\mpv\README.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('native\mpv\README.txt')" />
  </ItemGroup>
  <Target Name="PrepareLibMpvRuntime" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Get-LibMpvRuntime.ps1&quot;" />
    <Error Condition="!Exists('$(LibMpvLibraryPath)')" Text="Le runtime libmpv requis est absent après sa préparation : $(LibMpvLibraryPath)" />
    <ItemGroup>
      <Content Include="$(LibMpvRuntimeDirectory)\*.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="ValidateLibMpvBuildOutput" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(OutDir)native\mpv\libmpv-2.dll')" Text="Le build est incomplet : native\mpv\libmpv-2.dll est absent du dossier de sortie." />
  </Target>
  <Target Name="ValidateLibMpvPublishOutput" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Error Condition="!Exists('$(PublishDir)native\mpv\libmpv-2.dll')" Text="Le publish est incomplet : native\mpv\libmpv-2.dll est absent du dossier publié." />
  </Target>
  <Target Name="GenerateApplicationIcon" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Generate-AppIcon.ps1&quot; -OutputPath &quot;$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)IPTVExplorer.generated.ico&quot;" />
  </Target>
</Project>
